		"sources": {
			"contracts/types/DeworkTypes.sol": {
				"content": "// SPDX-License-Identifier: GPL-3.0\r\npragma solidity >=0.8.2 <0.9.0;\r\n\r\nstruct FreelancerProfile{\r\n    uint256 id;\r\n    string name;\r\n    address wallet;\r\n    uint8 experianceYears;\r\n    bool available;\r\n    uint256 hourlyRateWei; // 1 eth= 10^18\r\n}\r\n\r\nstruct EmployerProfile{\r\n    uint256 id;\r\n    string name;\r\n    address wallet;\r\n    bool isHiring;\r\n    JobListing[] jobListing;\r\n}\r\n\r\nstruct createJobListingInput{\r\n    string Title;\r\n    string jobDescription;\r\n    uint256 deadline;\r\n    uint256 fixedPayWei;\r\n}\r\n\r\nstruct JobListing{\r\n    uint256 id;\r\n    string title;\r\n    string description;\r\n    uint256 deadline;\r\n    bool isOpen;\r\n    uint256 fixedPayWei;\r\n    uint256 hiredFreelancerId;\r\n    bool hasHiredFreelancer;\r\n    bool isPaid;\r\n}"
			}
		}
	},
